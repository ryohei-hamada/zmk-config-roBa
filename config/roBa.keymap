// Onishi / Keyball39 migration test. Layers 4-6, trackball and BLE controls kept from stock.
// Layers 0-3 are a draft based on Remap screenshots. Do not flash until validated.
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include "roba-studio-macros.dtsi"

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <0>; // disable auto mouse, explicit Layer 3 only
    scroll-layers = <3 5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    // Disabled stock position-based combos for the Onishi trial layout.

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q  &kp L  &kp U  &kp COMMA  &kp DOT   &kp F  &kp W  &kp R  &kp Y  &kp P
                &mt LCTRL E  &mt LGUI I  &mt LALT A  &mt LSHFT O  &kp MINUS  &kp F13  &kp F14  &mt LALT K  &mt LSHFT T  &mt LA(LGUI) N  &mt LGUI S  &mt LCTRL H
                &kp Z  &kp X  &kp C  &kp V  &kp SEMICOLON  &trans  &trans  &kp G  &kp D  &kp M  &kp J  &lt 3 B
                &kp LC(LS(T))  &kp LG(LS(NUMBER_5))  &mkp MB1  &lt 3 TAB  &lt 1 SPACE  &kp AT_SIGN  &kp ENTER  &lt 2 BACKSPACE  &kp CAPSLOCK
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        NAV_NUM {
            bindings = <
                &kp AT_SIGN  &kp LEFT_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp SLASH  &kp ASTERISK  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp DOUBLE_QUOTES
                &kp DOLLAR  &kp LEFT_PARENTHESIS  &kp DOWN_ARROW  &kp RIGHT_PARENTHESIS  &kp BACKSPACE  &trans  &trans  &kp QUESTION  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_NUMBER_0
                &kp LG(LS(NUMBER_5))  &kp C_VOLUME_DOWN  &kp C_MUTE  &kp C_VOLUME_UP  &kp ENTER  &trans  &trans  &kp EXCLAMATION  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp SINGLE_QUOTE
                &kp INT_RO  &kp EQUAL  &kp HASH  &trans  &trans  &trans  &to 2  &to 0  &kp F12
            >;
        };

        SYMBOLS {
            bindings = <
                &kp HASH  &kp LEFT_BRACKET  &kp PIPE  &kp RIGHT_BRACKET  &kp EQUAL  &kp BACKSLASH  &kp LC(LEFT_ARROW)  &mkp MB3  &kp LC(RIGHT_ARROW)  &kp BACKSPACE
                &kp TILDE  &kp LEFT_BRACE  &kp DOLLAR  &kp RIGHT_BRACE  &kp AMPERSAND  &trans  &trans  &kp GRAVE  &kp LANG1  &kp LANG2  &kp LC(RIGHT_ARROW)  &kp SINGLE_QUOTE
                &kp QUESTION  &kp LESS_THAN  &kp PLUS  &kp GREATER_THAN  &kp PERCENT  &trans  &trans  &kp PIPE  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans
                &kp ESCAPE  &kp NUMBER_0  &kp DOT  &kp DELETE  &kp ENTER  &kp BACKSPACE  &trans  &trans  &trans
            >;
        };

        UTIL {
            bindings = <
                &none  &kp LG(NUMBER_1)  &none  &kp LG(NUMBER_2)  &none  &none  &none  &none  &kp LG(LC(LS(PAGE_DOWN)))  &none
                &none  &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_SHIFT  &none  &trans  &trans  &kp F19  &mkp MB1  &mkp MB2  &kp LG(LC(LS(PAGE_UP)))  &none
                &none  &none  &none  &none  &kp B  &trans  &trans  &kp ESCAPE  &kp LA(LG(NUMBER_6))  &kp LA(LG(MINUS))  &kp LA(LG(NUMBER_8))  &none
                &none  &kp KP_NUMBER_0  &none  &trans  &kp LG(W)  &trans  &trans  &trans  &bootloader
            >;
        };

        MOUSE {
            // Avoid overriding Onishi home-row T, N, S with mouse clicks.
            // Two otherwise-unused inner bottom-row keys become MB3/MB2
            // while the automouse layer is active. The base-layer MB1 stays.
            bindings = <
&trans  &trans  &trans  &trans  &trans                     &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &mkp MB3    &mkp MB2  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                        &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};

/ { behaviors { rs_dynamic: rs_dynamic { compatible = "roba,dynamic-macro"; #binding-cells = <2>; display-name = "roBa Dynamic Macro v1"; }; }; };
